{
  "meta": {
    "lastTouchedVersion": "2026.3.22"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "thu": {
        "baseUrl": "https://api.ithu.tw/v1",
        "apiKey": "YOUR_THU_API_KEY",
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "vibe",
            "name": "THU vibe (Inkling)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 768000,
            "maxTokens": 8192,
            "api": "openai-completions"
          },
          {
            "id": "vibecode",
            "name": "THU vibecode (Inkling)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 768000,
            "maxTokens": 8192,
            "api": "openai-completions"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "thu/vibe",
        "fallbacks": [
          "thu/vibecode"
        ]
      },
      "models": {
        "thu/vibe": {},
        "thu/vibecode": {}
      },
      "compaction": {
        "mode": "safeguard"
      }
    },
    "list": [
      {
        "id": "main",
        "model": {
          "primary": "thu/vibe",
          "fallbacks": [
            "thu/vibecode"
          ]
        }
      }
    ]
  },
  "tools": {
    "profile": "coding",
    "fs": {
      "workspaceOnly": true
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "gemini"
      },
      "fetch": {
        "enabled": true
      }
    }
  },
  "channels": {
    "line": {
      "enabled": true,
      "dmPolicy": "open",
      "groupPolicy": "open",
      "channelSecret": "YOUR_LINE_CHANNEL_SECRET",
      "channelAccessToken": "YOUR_LINE_CHANNEL_ACCESS_TOKEN",
      "allowFrom": [
        "*"
      ],
      "groupAllowFrom": [
        "*"
      ],
      "groups": {
        "*": {
          "requireMention": true
        },
        "YOUR_FAMILY_GROUP_ID": {
          "requireMention": true,
          "systemPrompt": "這是一個家庭生活群組。你的身份是家庭智慧生活管家（小爪），風格親切溫馨，回答生活百科、食譜料理、健康與天氣建議。"
        },
        "YOUR_LAB_GROUP_ID": {
          "requireMention": true,
          "systemPrompt": "這是一個實驗室研究群組。你的身份是實驗室智慧研究助理（小爪），風格專業嚴謹，專注於代碼、演算法、論文與專題討論。"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "YOUR_GATEWAY_TOKEN"
    }
  },
  "plugins": {
    "entries": {
      "line": {
        "enabled": true
      }
    }
  }
}
