{
  "models": {
    "mode": "merge",
    "providers": {
      "thu": {
        "baseUrl": "https://api.ithu.tw/v1",
        "apiKey": "YOUR_THU_API_KEY",
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "vibe",
            "name": "THU vibe (Inkling)",
            "input": ["text", "image"],
            "contextWindow": 768000,
            "maxTokens": 8192,
            "api": "openai-completions"
          },
          {
            "id": "vibecode",
            "name": "THU vibecode (Inkling Coder)",
            "contextWindow": 768000,
            "maxTokens": 8192,
            "api": "openai-completions"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "thu/vibe",
        "fallbacks": [
          "thu/vibecode"
        ]
      }
    },
    "list": [
      {
        "id": "main",
        "workspace": "/home/user/.openclaw/workspace"
      },
      {
        "id": "family",
        "workspace": "/home/user/.openclaw/workspace-family"
      },
      {
        "id": "lab",
        "workspace": "/home/user/.openclaw/workspace-lab"
      }
    ]
  },
  "bindings": [
    {
      "agentId": "family",
      "match": {
        "channel": "line",
        "accountId": "family"
      }
    },
    {
      "agentId": "lab",
      "match": {
        "channel": "line",
        "accountId": "lab"
      }
    }
  ],
  "tools": {
    "allow": [
      "web_search",
      "web_fetch"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "gemini"
      },
      "fetch": {
        "enabled": true
      }
    }
  },
  "channels": {
    "line": {
      "enabled": true,
      "accounts": {
        "family": {
          "enabled": true,
          "name": "小爪 🦞 (家庭小幫手)",
          "channelSecret": "YOUR_FAMILY_CHANNEL_SECRET",
          "channelAccessToken": "YOUR_FAMILY_CHANNEL_ACCESS_TOKEN",
          "webhookPath": "/line/family",
          "dmPolicy": "open",
          "groupPolicy": "open",
          "allowFrom": ["*"],
          "groupAllowFrom": ["*"],
          "groups": {
            "*": {
              "requireMention": true
            }
          }
        },
        "lab": {
          "enabled": true,
          "name": "小爪 🦞 (實驗室小助手)",
          "channelSecret": "YOUR_LAB_CHANNEL_SECRET",
          "channelAccessToken": "YOUR_LAB_CHANNEL_ACCESS_TOKEN",
          "webhookPath": "/line/lab",
          "dmPolicy": "open",
          "groupPolicy": "open",
          "allowFrom": ["*"],
          "groupAllowFrom": ["*"],
          "groups": {
            "*": {
              "requireMention": true
            }
          }
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "plugins": {
    "entries": {
      "line": {
        "enabled": true
      }
    }
  }
}
